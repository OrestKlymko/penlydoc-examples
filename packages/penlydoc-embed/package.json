{
  "name": "penlydoc-embed",
  "version": "0.1.0",
  "description": "Show the PenlyDoc e-signature page inside your web app: loads embed.js from PenlyDoc and mounts the signing frame, with TypeScript types.",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": { ".": { "types": "./index.d.ts", "default": "./index.js" } },
