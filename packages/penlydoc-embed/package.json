  "sideEffects": false,
  "keywords": ["e-signature", "electronic-signature", "embedded-signing", "esign", "pdf", "penlydoc"],
  "homepage": "https://penlydoc.com/docs/embed",
  "repository": { "type": "git", "url": "git+https://github.com/OrestKlymko/penlydoc-examples.git", "directory": "packages/penlydoc-embed" },
  "license": "MIT"
}
